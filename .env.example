# The app reads exported environment variables; it does not auto-load .env.
# Optional dedicated Hermes gateway or another compatible chat endpoint.
AGENT_MODEL_BASE_URL=http://127.0.0.1:8642/v1
AGENT_MODEL_NAME=dedicated-research-profile
AGENT_MODEL_API_KEY=
AGENT_MODEL_MAX_TOKENS=3000
# Required for non-loopback serving. Generate a random token >=24 characters.
AGENT_UI_TOKEN=
# Explicit reverse-proxy hostnames, comma separated. No wildcards.
AGENT_UI_ALLOWED_HOSTS=
# Optional: only when your provider supports this field
AGENT_MODEL_REASONING_EFFORT=

# Streaming activity can continue beyond a single idle window, within the mission deadline.
AGENT_MODEL_STREAM=true
AGENT_MODEL_IDLE_SECONDS=120
# Explicit public-query search (MiniMax Coding Plan access required).
# Set this yourself; no other credential files are read.
AGENT_SEARCH_PROVIDER=minimax
AGENT_SEARCH_API_KEY=

# Optional UTF-8 instructions file outside the repository. Not auto-discovered.
AGENT_INSTRUCTIONS_FILE=

# Optional private document skills directory outside source control. No scripts execute.
AGENT_SKILLS_DIR=

# Optional private JSON file mapping names to confirmed Hermes delivery destinations.
# This is never auto-discovered; keep it outside the repository.
AGENT_MONITOR_DELIVERY_CONFIG=
