{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "field-evidence/v1",
  "type": "object",
  "required": [
    "schema",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "field-evidence/v1"
    },
    "records": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "title",
          "body",
          "url",
          "countries",
          "topics"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "event_key": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "source_claim",
              "operator_verified",
              "synthetic"
            ]
          },
          "synthetic": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
